{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in *.rs) cd \"$CLAUDE_PROJECT_DIR\" && cargo fmt --all >/dev/null 2>&1 ;; esac; exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-script.sh >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "Checking for <script> outside enhance.rs"
          }
        ]
      }
    ]
  }
}
