#[debug_handler]
async fn create(
{% if auth %}    {% if owned %}auth{% else %}_auth{% endif %}: auth::JWT,
{% endif %}    ui: Ui,
    State(ctx): State<AppContext>,
    Valid(form): Valid<Params>,
) -> Result<Response> {
{% if owned %}    let me = owner(&ctx, &auth).await?;
{% endif %}    let p = match form {
        Ok(p) => p,
        Err(bad) => {
            let title = "New {{ snake_singular | replace(from="_", to=" ") }}";
            let body = views::{{ snake_plural }}::form(&ui, title, "/{{ snake_plural }}", &bad.values, &bad.errors.pairs(), &refs(&ctx).await?);
            return Ok(ui.page(title, body).into_response());
        }
    };
    let mut item = ActiveModel {
