#[cfg(test)]
mod tests {
    use sea_orm::{DbBackend, QueryTrait};

    use super::*;

    /// The list's search{% if texts %} looks in the text columns{% endif %} and its sort follows the URL.
    #[test]
    fn the_list_searches_and_sorts() {
        let ui = Ui::from_request("/{{ snake_plural }}", "q.{{ snake_plural }}=ada&sort.{{ snake_plural }}=-{{ sorts | last }}", "");
        let table = ui.table_query(TABLE, SORTABLE);
        let sql = query(&table{% if owned %}, 7{% endif %}{% if parent %}, Some(3){% endif %}).build(DbBackend::Sqlite).to_string();
{%- for t in texts %}
        assert!(sql.contains(r#""{{ snake_plural }}"."{{ t }}" LIKE '%ada%'"#), "{sql}");
{%- endfor %}
        assert!(sql.contains(r#"ORDER BY "{{ snake_plural }}"."{{ sorts | last }}" DESC, "{{ snake_plural }}"."id" ASC"#), "{sql}");
{%- if owned %}
        assert!(sql.contains(r#""{{ snake_plural }}"."user_id" = 7"#), "{sql}");
{%- endif %}
{%- if parent %}
        assert!(sql.contains(r#""{{ snake_plural }}"."{{ parent_id }}" = 3"#), "{sql}");
{%- endif %}
    }

    #[test]
    fn a_csv_cell_is_quoted_and_never_a_formula() {
        assert_eq!(csv_cell("plain"), "plain");
        assert_eq!(csv_cell("a, \"b\""), "\"a, \"\"b\"\"\"");
        assert_eq!(csv_cell("=1+1"), "'=1+1");
    }
}
