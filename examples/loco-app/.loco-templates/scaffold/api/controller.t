/// What each reference field can point at: every row of the parent table as `(id, label)`,
/// labelled by its name, title or email (`loco_ui::loco::label`). The form lists them in a
/// select; past a few hundred rows, swap it for `ui.combobox(..)` with a search route.
#[allow(unused_variables)] // `ctx` when the model has no references
async fn refs(ctx: &AppContext) -> Result<views::{{ snake_plural }}::Refs> {
    Ok(views::{{ snake_plural }}::Refs {
{%- for f in fields %}
{%- if owned and f.field_name == "user_id" %}{% continue %}{% endif %}
{%- set is_ref = f.input_kind == "number" and f.field_name is ending_with("_id") and f.rust_type is containing("i64") %}
{%- if is_ref %}
        {{ f.field_name }}: crate::models::_entities::{{ f.field_name | trim_end_matches(pat="_id") | plural }}::Entity::find()
            .all(&ctx.db)
            .await?
            .iter()
            .map(|m| (m.id.to_string(), loco_ui::loco::label(m)))
            .collect(),
{%- endif %}
{%- endfor %}
    })
}

/// The rows the list asks for: {% if texts %}the search text in any text column (SQL `LIKE`), {% endif %}sorted by the
/// column the URL names, then by id.{% if owned %} Only `owner`'s.{% endif %}{% if parent %} With `parent`, only that {{ parent }}'s.{% endif %}
#[allow(unused_variables)] // `table` without text columns{% if parent %}, `parent`{% endif %}
fn query(table: &TableQuery{% if owned %}, owner: i64{% endif %}{% if parent %}, parent: Option<i64>{% endif %}) -> Select<Entity> {
    let mut select = Entity::find(){% if owned %}.filter(Column::UserId.eq(owner)){% endif %};
{%- if parent %}
    if let Some(parent) = parent {
        select = select.filter(Column::{{ parent_id | pascal_case }}.eq(parent));
    }
{%- endif %}
{%- if texts %}
    let text = table.filter();
    if !text.is_empty() {
        select = select.filter(
            Condition::any(){% for t in texts %}.add(Column::{{ t | pascal_case }}.contains(text)){% endfor %},
        );
    }
{%- endif %}
    // One `ORDER BY` per sort key, most significant first (`?sort.<id>=title,-id`).
    for &(key, desc) in table.sort() {
        if let Ok(column) = key.parse::<Column>() {
            select = select.order_by(column, if desc { Order::Desc } else { Order::Asc });
        }
    }
    select.order_by_asc(Column::Id)
}

