//! {{ pascal_singular }} pages: list, show, new, edit and delete as plain HTML forms with
//! Post/Redirect/Get. Generated by the loco-ui scaffold templates; edit freely.
{%- if owned %}
//!
//! Every row belongs to a user: each query is scoped to the signed-in user (`owner`), and a
//! new row's `user_id` comes from the session, never from the form. Another user's row
//! answers 404.
{%- elif auth %}
//!
//! Every signed-in user sees and changes every row. To give each row an owner, generate the
//! model with a `user:references` field: the controller then scopes every query to the
//! signed-in user.
{%- endif %}
#![allow(clippy::unused_async)]
use loco_ui::{loco::Valid, prelude::*};
use loco_rs::prelude::*;
use serde::Deserialize;
{%- if prelude_use %}
#[allow(unused_imports)] // Loco lists the timestamp types too
{{ prelude_use }}
{%- endif %}

use crate::{
    models::_entities::{{ snake_plural }}::{ActiveModel, Column, Entity, Model},
    views,
};

/// The posted fields. `Valid<Params>` reads them, or gives back a message for every field in
/// error and what was posted; add `#[validate(..)]` rules here.
#[derive(Deserialize, Validate)]
struct Params {
{%- for f in fields %}
{%- if owned and f.field_name == "user_id" %}{% continue %}{% endif %}
{%- if f.input_kind == "checkbox" and not f.nullable %}
    #[serde(default, deserialize_with = "loco_ui::loco::checkbox")]
    {{ f.field_name }}: bool,
{%- elif f.input_kind == "datetime" %}
    #[serde({% if f.nullable %}default, {% endif %}deserialize_with = "loco_ui::loco::local")]
    {{ f.field_name }}: {{ f.rust_type }},
{%- elif f.is_enum %}
    {{ f.field_name }}: {% if f.nullable %}Option<String>{% else %}String{% endif %},
{%- else %}
    {{ f.field_name }}: {{ f.rust_type }},
{%- endif %}
{%- endfor %}
}

fn set(item: &mut ActiveModel, p: Params) {
{%- for f in fields %}
{%- if owned and f.field_name == "user_id" %}{% continue %}{% endif %}
    item.{{ f.field_name }} = Set(p.{{ f.field_name }});
{%- endfor %}
}

/// What each reference field can point at: every row of the parent table as `(id, label)`,
/// labelled by its name, title or email (`loco_ui::loco::label`). The form lists them in a
/// select; past a few hundred rows, swap it for `ui.combobox(..)` with a search route.
#[allow(unused_variables)] // `ctx` when the model has no references
async fn refs(ctx: &AppContext) -> Result<views::{{ snake_plural }}::Refs> {
    Ok(views::{{ snake_plural }}::Refs {
{%- for f in fields %}
{%- if owned and f.field_name == "user_id" %}{% continue %}{% endif %}
{%- set is_ref = f.input_kind == "number" and f.field_name is ending_with("_id") and f.rust_type is containing("i64") %}
{%- if is_ref %}
        {{ f.field_name }}: crate::models::_entities::{{ f.field_name | trim_end_matches(pat="_id") | plural }}::Entity::find()
            .all(&ctx.db)
            .await?
            .iter()
            .map(|m| (m.id.to_string(), loco_ui::loco::label(m)))
            .collect(),
{%- endif %}
{%- endfor %}
    })
}

{% if owned %}
/// The signed-in user, whose rows every handler below reads and writes.
async fn owner(ctx: &AppContext, auth: &auth::JWT) -> Result<crate::models::users::Model> {
    Ok(crate::models::users::Model::find_by_pid(&ctx.db, &auth.claims.pid).await?)
}

/// Row `id` if it belongs to `owner`, else 404.
async fn load(ctx: &AppContext, id: i64, owner: i64) -> Result<Model> {
    Entity::find_by_id(id).filter(Column::UserId.eq(owner)).one(&ctx.db).await?.ok_or(Error::NotFound)
}
{% else %}
async fn load(ctx: &AppContext, id: i64) -> Result<Model> {
    Entity::find_by_id(id).one(&ctx.db).await?.ok_or(Error::NotFound)
}
{% endif %}

#[debug_handler]
async fn list(
{% if auth %}    {% if owned %}auth{% else %}_auth{% endif %}: auth::JWT,
{% endif %}    ui: Ui,
    State(ctx): State<AppContext>,
) -> Result<Page> {
{% if owned %}    let me = owner(&ctx, &auth).await?;
{% endif %}    let table = ui.table("{{ snake_plural }}", "");
    let wanted = query::PaginationQuery {
        page: table.page() as u64,
        page_size: table.per_page() as u64,
    };
    let found = query::fetch_page(&ctx.db, Entity::find(){% if owned %}.filter(Column::UserId.eq(me.id)){% endif %}.order_by_asc(Column::Id), &wanted).await?;
    Ok(ui.page("{{ pascal_plural }}", views::{{ snake_plural }}::list(&ui, &found.page, &found.meta)))
}

