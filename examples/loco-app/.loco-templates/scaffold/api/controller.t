/// The signed-in user, whose rows every handler below reads and writes.
async fn owner(ctx: &AppContext, auth: &auth::JWT) -> Result<crate::models::users::Model> {
    Ok(crate::models::users::Model::find_by_pid(&ctx.db, &auth.claims.pid).await?)
}

/// Row `id` if it belongs to `owner`, else 404.
async fn load(ctx: &AppContext, id: i64, owner: i64) -> Result<Model> {
    Entity::find_by_id(id).filter(Column::UserId.eq(owner)).one(&ctx.db).await?.ok_or(Error::NotFound)
}
{% else %}
async fn load(ctx: &AppContext, id: i64) -> Result<Model> {
    Entity::find_by_id(id).one(&ctx.db).await?.ok_or(Error::NotFound)
}
{% endif %}

/// One page of the list at `base` (`/{{ snake_plural }}`{% if parent %}, or `/{{ parent | plural }}/{id}/{{ snake_plural }}`{% endif %}).
async fn page_of(ui: &Ui, ctx: &AppContext, base: &str{% if owned %}, owner: i64{% endif %}{% if parent %}, parent: Option<i64>{% endif %}) -> Result<Page> {
    let table = ui.table_query(TABLE, SORTABLE);
    let wanted = query::PaginationQuery {
        page: table.page() as u64,
        page_size: table.per_page() as u64,
    };
    let found = query::fetch_page(&ctx.db, query(&table{% if owned %}, owner{% endif %}{% if parent %}, parent{% endif %}), &wanted).await?;
    Ok(ui.page("{{ pascal_plural }}", views::{{ snake_plural }}::list(ui, &found.page, &found.meta, base)))
}

/// Every row the list's search and sort find, not one page, as CSV: the list's "Download
/// CSV" link.
async fn csv_of(ui: &Ui, ctx: &AppContext{% if owned %}, owner: i64{% endif %}{% if parent %}, parent: Option<i64>{% endif %}) -> Result<Response> {
    let table = ui.table_query(TABLE, SORTABLE);
    let rows = query(&table{% if owned %}, owner{% endif %}{% if parent %}, parent{% endif %}).all(&ctx.db).await?;
    let mut out = String::from("id");
    for (name, _) in rows.first().map(views::{{ snake_plural }}::values).unwrap_or_default() {
        out.push(',');
        out.push_str(&name);
    }
    out.push('\n');
    for m in &rows {
        out.push_str(&m.id.to_string());
        for (_, value) in views::{{ snake_plural }}::values(m) {
            out.push(',');
            out.push_str(&csv_cell(&value));
        }
        out.push('\n');
    }
    let headers = [
        ("content-type", "text/csv; charset=utf-8"),
        ("content-disposition", "attachment; filename=\"{{ snake_plural }}.csv\""),
    ];
    Ok((headers, out).into_response())
}

/// A CSV field: quoted when it holds a comma, a quote or a line break, and a leading `=`,
/// `+` or `@` escaped with `'` so a spreadsheet does not run it as a formula.
fn csv_cell(value: &str) -> String {
    let value = if value.starts_with(['=', '+', '@', '\t', '\r']) {
        format!("'{value}")
    } else {
        value.to_string()
    };
    if value.contains([',', '"', '\n', '\r']) {
        format!("\"{}\"", value.replace('"', "\"\""))
    } else {
        value
    }
}

