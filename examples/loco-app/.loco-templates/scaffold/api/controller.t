#[debug_handler]
async fn update(
{% if auth %}    {% if owned %}auth{% else %}_auth{% endif %}: auth::JWT,
{% endif %}    ui: Ui,
    State(ctx): State<AppContext>,
    Path(id): Path<i64>,
    Valid(form): Valid<Params>,
) -> Result<Response> {
{% if owned %}    let me = owner(&ctx, &auth).await?;
{% endif %}    let item = load(&ctx, id{% if owned %}, me.id{% endif %}).await?;
    let action = format!("/{{ snake_plural }}/{id}");
    let p = match form {
        Ok(p) => p,
        Err(bad) => {
            let title = "Edit {{ snake_singular | replace(from="_", to=" ") }}";
