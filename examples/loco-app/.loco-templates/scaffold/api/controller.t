            return Ok(ui.page(title, body).into_response());
        }
    };
    let mut item = item.into_active_model();
    set(&mut item, p);
    item.update(&ctx.db).await?;
    Ok(ui.redirect(&action).ok("Saved.").into_response())
}

#[debug_handler]
async fn remove(
{% if auth %}    {% if owned %}auth{% else %}_auth{% endif %}: auth::JWT,
{% endif %}    ui: Ui,
    State(ctx): State<AppContext>,
    Path(id): Path<i64>,
) -> Result<Redirect> {
{% if owned %}    let me = owner(&ctx, &auth).await?;
{% endif %}    load(&ctx, id{% if owned %}, me.id{% endif %}).await?.into_active_model().delete(&ctx.db).await?;
    Ok(ui.redirect("/{{ snake_plural }}").ok("Deleted."))
}

pub fn routes() -> Routes {
    Routes::new()
        .prefix("/{{ snake_plural }}")
        .add("/", get(list).post(create))
        .add("/new", get(new))
        .add("/{id}", get(show).post(update))
        .add("/{id}/edit", get(edit))
        .add("/{id}/delete", post(remove))
}
