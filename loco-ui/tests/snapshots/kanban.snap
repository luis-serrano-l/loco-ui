<input type="hidden" name="card" value="c2">
<button type="submit" class="lui-button lui-button-ghost lui-button-small lui-button-icon" name="to" value="todo" aria-label="Move Calendar to To do">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="arrow-left">
<path d="m12 19-7-7 7-7"/>
<path d="M19 12H5"/>
</svg>
</button>
<button type="submit" class="lui-button lui-button-ghost lui-button-small lui-button-icon" name="to" value="done" aria-label="Move Calendar to Done">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="arrow-right">
<path d="M5 12h14"/>
<path d="m12 5 7 7-7 7"/>
</svg>
</button>
</form>
</div>
</li>
<li class="lui-kanban-card" style="view-transition-name: lui-kanban-c3">
<p class="lui-kanban-title">Upload</p>
<div class="lui-kanban-meta">
<form method="post" action="/board/move" class="lui-kanban-move">
<input type="hidden" name="card" value="c3">
<button type="submit" class="lui-button lui-button-ghost lui-button-small lui-button-icon" name="to" value="todo" aria-label="Move Upload to To do">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="arrow-left">
<path d="m12 19-7-7 7-7"/>
<path d="M19 12H5"/>
</svg>
</button>
<button type="submit" class="lui-button lui-button-ghost lui-button-small lui-button-icon" name="to" value="done" aria-label="Move Upload to Done">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="arrow-right">
<path d="M5 12h14"/>
<path d="m12 5 7 7-7 7"/>
</svg>
</button>
</form>
</div>
</li>
</ol>
</section>
<section class="lui-kanban-column" aria-labelledby="lui-kanban--board-move-done">
<header class="lui-kanban-head">
<h3 id="lui-kanban--board-move-done">Done</h3>
