---
source: loco-ui/tests/snapshots.rs
---
caps: all
<div id="lui-table-files" data-lui="swap" class="lui-table">
<div class="lui-table-toolbar">
<search class="lui-table-filter">
<form method="get" action="/table">
<input type="hidden" name="sort.files" value="name">
<input type="hidden" name="cols.files" value="name,size">
<input id="lui-table-files-q" class="lui-table-filter-input" name="q.files" type="search" value="a" placeholder="Filter rows…" autocomplete="off" aria-label="Filter rows">
<button type="submit" class="lui-button">Filter</button>
<a class="lui-table-clear" href="/table?sort.files=name&amp;cols.files=name%2Csize">Clear</a>
</form>
</search>
<details class="lui-table-cols">
<summary class="lui-button">Columns<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="chevron-down">
<path d="m6 9 6 6 6-6"/>
</svg>
</summary>
<ul>
<li>
<a href="/table?sort.files=name&amp;q.files=a&amp;cols.files=size" aria-pressed="true">
<span class="lui-table-cols-mark" aria-hidden="true">☑</span> Name</a>
</li>
<li>
<a href="/table?sort.files=name&amp;q.files=a&amp;cols.files=name" aria-pressed="true">
<span class="lui-table-cols-mark" aria-hidden="true">☑</span> Size</a>
</li>
<li>
<a href="/table?sort.files=name&amp;q.files=a&amp;cols.files=name%2Csize%2Cnote" aria-pressed="false">
<span class="lui-table-cols-mark" aria-hidden="true">☐</span> Note</a>
</li>
</ul>
</details>
<a class="lui-button lui-button-small lui-table-csv" href="/table.csv?sort.files=name&amp;q.files=a&amp;cols.files=name%2Csize" download>
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="download">
<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
<path d="m7 10 5 5 5-5"/>
<path d="M12 15V3"/>
</svg>Download CSV</a>
</div>
<div class="lui-table-scroll lui-table-has-select">
<table>
<colgroup>
<col class="lui-table-select-col">
<col>
<col style="width: 6rem">
<col class="lui-table-menu-col">
</colgroup>
<thead>
<tr>
<th scope="col" class="lui-table-select">
<span class="lui-sr">Select</span>
</th>
<th scope="col" aria-sort="ascending" class="lui-table-sorted">
<a href="/table?sort.files=-name&amp;q.files=a&amp;cols.files=name%2Csize">Name<span class="lui-table-arrow">▲</span>
</a>
</th>
<th scope="col" class=" lui-table-num">
<a href="/table?sort.files=size&amp;q.files=a&amp;cols.files=name%2Csize">Size</a>
<a class="lui-table-then" href="/table?sort.files=name,size&amp;q.files=a&amp;cols.files=name%2Csize" aria-label="Then by Size" title="Then by Size">+</a>
</th>
<th scope="col" class="lui-table-menu">
<span class="lui-sr">Actions</span>
</th>
</tr>
</thead>
<tbody style="view-transition-name: lui-table-files">
<tr>
<td class="lui-table-select">
<input type="checkbox" class="lui-table-check" name="row" value="a.txt" form="lui-table-files-bulk" aria-label="Select a.txt">
</td>
<td>
<details class="lui-table-detail">
<summary>a.txt</summary>
<div class="lui-table-detail-body">
<p>Modified today.</p>
</div>
</details>
</td>
<td class="lui-table-num">1 KB</td>
<td class="lui-table-menu">
<div class="lui-popover lui-popover-anchored lui-popover-end" style="anchor-name: --lui-table-files-a-txt">
<button type="button" class="lui-button lui-button-ghost lui-button-small lui-button-icon" data-size="1" data-tone="neutral" data-variant="ghost" popovertarget="lui-table-files-a-txt" aria-label="Row actions" aria-haspopup="menu">⋯</button>
<nav id="lui-table-files-a-txt" popover style="position-anchor: --lui-table-files-a-txt; position-area: bottom span-left">
<ul role="menu">
<li role="none">
<a class="lui-popover-item" role="menuitem" href="/files/a.txt">
<span class="lui-popover-text">Open</span>
</a>
</li>
<li role="none">
<form method="post" action="/files/a.txt/delete">
<button type="submit" class="lui-popover-item lui-popover-danger" role="menuitem">
<span class="lui-popover-text">Delete</span>
</button>
</form>
</li>
</ul>
</nav>
</div>
</td>
</tr>
</tbody>
</table>
</div>
<form method="post" action="/files/bulk" id="lui-table-files-bulk" class="lui-table-bulk">
<span>With the selected rows:</span>
<button type="submit" class="lui-button lui-button-small" data-size="1" name="action" value="archive">Archive</button>
<button type="submit" class="lui-button lui-button-small" data-size="1" name="action" value="delete">Delete</button>
</form>
</div>

