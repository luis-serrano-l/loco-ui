<figure class="lui-chart lui-chart-line" id="chart-latency">
<figcaption class="lui-chart-legend" aria-hidden="true">
<span class="lui-chart-swatch">
</span>Latency</figcaption>
<svg viewBox="0 0 600 240" role="group" aria-labelledby="chart-latency-title chart-latency-desc">
<title id="chart-latency-title">Latency</title>
<desc id="chart-latency-desc">p50 per day, last week</desc>
<line class="lui-chart-grid" stroke="currentColor" stroke-opacity="0.15" x1="44" x2="598" y1="212.0" y2="212.0"/>
<text class="lui-chart-tick" font-family="sans-serif" font-size="12" x="38" y="216.0" text-anchor="end">0</text>
<line class="lui-chart-grid" stroke="currentColor" stroke-opacity="0.15" x1="44" x2="598" y1="144.7" y2="144.7"/>
<text class="lui-chart-tick" font-family="sans-serif" font-size="12" x="38" y="148.7" text-anchor="end">20</text>
<line class="lui-chart-grid" stroke="currentColor" stroke-opacity="0.15" x1="44" x2="598" y1="77.3" y2="77.3"/>
<text class="lui-chart-tick" font-family="sans-serif" font-size="12" x="38" y="81.3" text-anchor="end">40</text>
<line class="lui-chart-grid" stroke="currentColor" stroke-opacity="0.15" x1="44" x2="598" y1="10.0" y2="10.0"/>
<text class="lui-chart-tick" font-family="sans-serif" font-size="12" x="38" y="14.0" text-anchor="end">60</text>
<polyline class="lui-chart-path" fill="none" stroke="currentColor" stroke-width="2" points="182.5,72.3 459.5,84.1"/>
<g class="lui-chart-mark" tabindex="0" role="img" aria-label="Mon: 41.5 ms">
<circle class="lui-chart-dot" fill="none" stroke="currentColor" stroke-width="2" cx="182.5" cy="72.3" r="4"/>
<g class="lui-chart-tip">
<rect x="132.5" y="38.3" width="100.0" height="22" rx="4"/>
<text x="182.5" y="53.3" text-anchor="middle" font-size="12">Mon: 41.5 ms</text>
</g>
</g>
<g class="lui-chart-mark" tabindex="0" role="img" aria-label="Tue: 38 ms">
<circle class="lui-chart-dot" fill="none" stroke="currentColor" stroke-width="2" cx="459.5" cy="84.1" r="4"/>
<g class="lui-chart-tip">
<rect x="416.5" y="50.1" width="86.0" height="22" rx="4"/>
<text x="459.5" y="65.1" text-anchor="middle" font-size="12">Tue: 38 ms</text>
</g>
</g>
<text class="lui-chart-label" font-family="sans-serif" font-size="12" x="182.5" y="232.0" text-anchor="middle">Mon</text>
<text class="lui-chart-label lui-chart-label-odd" font-family="sans-serif" font-size="12" x="459.5" y="232.0" text-anchor="middle">Tue</text>
</svg>
<div class="lui-sr">
<table>
<caption>Latency</caption>
<tr>
<th scope="row">Mon</th>
<td>41.5 ms</td>
</tr>
<tr>
<th scope="row">Tue</th>
<td>38 ms</td>
</tr>
</table>
</div>
</figure>

