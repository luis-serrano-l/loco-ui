<span class="lui-radio-group-text">
<span class="lui-radio-group-title">Hobby</span>
<span id="f-tier-0-description" class="lui-radio-group-description">One project</span>
</span>
</label>
<label for="f-tier-1" class="lui-radio-group-option">
<input id="f-tier-1" type="radio" name="tier" value="team" checked aria-describedby="f-tier-1-description">
<span class="lui-radio-group-text">
