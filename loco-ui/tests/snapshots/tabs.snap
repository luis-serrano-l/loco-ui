caps: all
<div id="lui-tabs-docs" data-lui="swap" class="lui-tabs lui-tabs-vertical" data-orientation="vertical">
<form method="get" action="/docs" class="lui-tabs-select">
<select name="tab.docs" aria-label="Tab">
<option value="0">Install</option>
<option value="1" selected>Use (3)</option>
<option value="2">Changelog</option>
</select>
<button type="submit" class="lui-button">Go</button>
</form>
<div class="lui-tabs-list">
<a class="lui-tabs-trigger" href="/docs?tab.docs=0" data-state="inactive">
<span class="lui-tabs-label">Install</span>
</a>
<a class="lui-tabs-trigger" href="/docs?tab.docs=1" data-state="active" aria-current="true">
<span class="lui-tabs-mark" style="view-transition-name: lui-tabs-docs; view-transition-class: lui-tabs-mark">
</span>
<span class="lui-tabs-label">Use <span class="lui-tabs-badge">3</span>
</span>
</a>
<a class="lui-tabs-trigger" href="/docs?tab.docs=2" data-state="inactive">
<span class="lui-tabs-label">Changelog</span>
</a>
</div>
<div class="lui-tabs-panel" data-state="inactive" hidden>
<p>cargo add</p>
</div>
<div class="lui-tabs-panel" data-state="active">
<p>html!</p>
</div>
<div class="lui-tabs-panel" data-state="inactive" hidden>
<span class="lui-tabs-lazy">
</span>
</div>
</div>

caps: none
