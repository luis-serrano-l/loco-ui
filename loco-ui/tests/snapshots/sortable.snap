<div id="lui-sortable--tasks-order" data-lui="swap" data-lui-morph class="lui-sortable">
<ol class="lui-sortable-list" aria-label="Tasks">
<li class="lui-sortable-item" style="view-transition-name: lui-sortable-a">
<span class="lui-sortable-grip" aria-hidden="true">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="grip-vertical">
<circle cx="9" cy="12" r="1"/>
<circle cx="9" cy="5" r="1"/>
<circle cx="9" cy="19" r="1"/>
<circle cx="15" cy="12" r="1"/>
<circle cx="15" cy="5" r="1"/>
<circle cx="15" cy="19" r="1"/>
</svg>
</span>
<div class="lui-sortable-text">
<p class="lui-sortable-title">Write the docs</p>
<p class="lui-sortable-note">Due Friday</p>
</div>
<form method="post" action="/tasks/order" class="lui-sortable-move">
<input type="hidden" name="item" value="a">
<span class="lui-sortable-slot">
</span>
<button type="submit" class="lui-button lui-button-ghost lui-button-small lui-button-icon" data-size="1" data-tone="neutral" data-variant="ghost" name="to" value="1" aria-label="Move Write the docs down" id="lui-sortable--tasks-order-a-down">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="chevron-down">
<path d="m6 9 6 6 6-6"/>
</svg>
</button>
</form>
</li>
<li class="lui-sortable-item" style="view-transition-name: lui-sortable-b">
<span class="lui-sortable-grip" aria-hidden="true">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="grip-vertical">
<circle cx="9" cy="12" r="1"/>
<circle cx="9" cy="5" r="1"/>
<circle cx="9" cy="19" r="1"/>
<circle cx="15" cy="12" r="1"/>
<circle cx="15" cy="5" r="1"/>
<circle cx="15" cy="19" r="1"/>
</svg>
</span>
<div class="lui-sortable-text">
<p class="lui-sortable-title">Ship the release</p>
</div>
<form method="post" action="/tasks/order" class="lui-sortable-move">
<input type="hidden" name="item" value="b">
<button type="submit" class="lui-button lui-button-ghost lui-button-small lui-button-icon" data-size="1" data-tone="neutral" data-variant="ghost" name="to" value="0" aria-label="Move Ship the release up" id="lui-sortable--tasks-order-b-up">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="chevron-up">
<path d="m18 15-6-6-6 6"/>
</svg>
</button>
<span class="lui-sortable-slot">
</span>
</form>
</li>
</ol>
</div>

