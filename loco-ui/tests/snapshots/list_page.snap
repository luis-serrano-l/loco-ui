caps: all
<div class="lui-list-page">
<div class="lui-list-page-head">
<div class="lui-list-page-title">
<h1>Customers</h1>
<p class="lui-list-page-description">Everyone who bought something.</p>
</div>
</div>
<div class="lui-list-page-toolbar">
<search class="lui-search">
<form method="get" action="/">
<div class="lui-input-slots">
<span class="lui-input-leading">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="search">
<circle cx="11" cy="11" r="8"/>
<path d="m21 21-4.3-4.3"/>
</svg>
</span>
<input id="f-q" class="lui-search-input" name="q" type="search" value="" aria-label="Search customers">
</div>
<button type="submit" class="lui-button">Search</button>
</form>
</search>
<nav class="lui-list-page-filters" aria-label="Filters">
<a class="lui-list-page-filter" href="/customers">All</a>
<a class="lui-list-page-filter" href="/customers?status=open">Open <span class="lui-badge lui-badge-secondary" data-tone="neutral">3</span>
</a>
</nav>
</div>
<p class="lui-list-page-count">3 customers</p>
<div class="lui-list-page-body">
<ul>
<li>Ada</li>
</ul>
</div>
</div>

