caps: all
<div class="lui-field">
<label for="f-email">Email <span class="lui-field-required" aria-hidden="true">*</span>
</label>
<input id="f-email" name="email" type="email" value="ada@x.org" required aria-invalid="true" aria-describedby="f-email-help f-email-error">
<small id="f-email-help" class="lui-field-help">We never share it.</small>
<p id="f-email-error" class="lui-error" role="alert">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="triangle-alert">
<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/>
<path d="M12 9v4"/>
<path d="M12 17h.01"/>
</svg>Already taken.</p>
</div>

