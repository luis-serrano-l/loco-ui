---
source: loco-ui/tests/snapshots.rs
---
caps: all
<form id="lui-counter--counter" data-lui="swap" class="lui-counter" method="post" action="/counter">
<button type="submit" class="lui-button lui-button-icon" name="op" value="dec" aria-label="decrement">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="minus">
<path d="M5 12h14"/>
</svg>
</button>
<output style="view-transition-name: lui-counter">10</output>
<button type="submit" class="lui-button lui-button-icon" name="op" value="inc" aria-label="increment" disabled>
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="plus">
<path d="M5 12h14"/>
<path d="M12 5v14"/>
</svg>
</button>
<button type="submit" class="lui-button lui-button-ghost" data-tone="neutral" data-variant="ghost" name="op" value="reset">Reset</button>
<input id="lui-counter--counter-value" class="lui-counter-input" name="value" type="number" value="10" min="0" max="10" step="2" inputmode="numeric" aria-label="Value">
<button type="submit" class="lui-button" name="op" value="set">Set</button>
<small class="lui-counter-bounds">0 to 10, in steps of 2</small>
</form>

caps: none
