<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="chevron-left">
<path d="m15 18-6-6 6-6"/>
</svg>
</a>
<p id="lui-calendar-due-title" class="lui-calendar-title" aria-live="polite">September 2026</p>
<a class="lui-button lui-button-ghost lui-button-small lui-button-icon" data-size="1" data-tone="neutral" data-variant="ghost" href="/?month.due=2026-10" aria-label="Next month">
