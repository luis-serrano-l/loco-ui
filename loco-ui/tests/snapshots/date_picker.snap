caps: all
<div class="lui-field lui-date-picker">
<label for="f-due">Due date</label>
<div class="lui-date-picker-anchor" style="anchor-name: --f-due-calendar">
<button type="button" class="lui-button lui-date-picker-trigger" popovertarget="f-due-calendar" id="f-due" aria-haspopup="dialog">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="calendar">
<path d="M8 2v4"/>
<path d="M16 2v4"/>
<rect width="18" height="18" x="3" y="4" rx="2"/>
<path d="M3 10h18"/>
</svg>
<span>24 September 2026</span>
<span class="lui-date-picker-chevron">
<svg class="lui-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="chevron-down">
<path d="m6 9 6 6 6-6"/>
</svg>
</span>
</button>
<div id="f-due-calendar" popover class="lui-date-picker-panel" style="position-anchor: --f-due-calendar; position-area: bottom span-right">
<div id="lui-calendar-due" data-lui="swap" class="lui-calendar" role="radiogroup" aria-labelledby="lui-calendar-due-title">
